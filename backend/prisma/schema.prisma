model membership_transactions {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  player_id                String            @db.Uuid
  from_tier                membership_level?
  to_tier                  membership_level
  transaction_type         String            @db.VarChar(50)
  amount                   Decimal           @db.Decimal(10, 2)
  stripe_payment_intent_id String?
  stripe_subscription_id   String?
  payment_status           String?           @default("pending") @db.VarChar(50)
  effective_date           DateTime          @db.Date
  expires_date             DateTime?         @db.Date
  notes                    String?
  created_at               DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?         @default(now()) @db.Timestamptz(6)
  players                  players           @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([effective_date], map: "idx_membership_transactions_effective")
  @@index([player_id], map: "idx_membership_transactions_player")
  @@index([payment_status], map: "idx_membership_transactions_status")
  @@index([transaction_type], map: "idx_membership_transactions_type")
  @@schema("app_auth")
}

