generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app_auth", "contact", "crowdfunding", "events", "launch", "public", "system"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model admin_users {
  id                                    String                         @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  account_id                            String                         @db.Uuid
  username                              String                         @unique @db.VarChar(50)
  first_name                            String?                        @db.VarChar(100)
  last_name                             String?                        @db.VarChar(100)
  role                                  String                         @default("viewer") @db.VarChar(50)
  permissions                           Json?                          @default("{}")
  avatar_url                            String?
  phone                                 String?                        @db.VarChar(20)
  department                            String?                        @db.VarChar(100)
  is_super_admin                        Boolean?                       @default(false)
  last_active                           DateTime?                      @db.Timestamptz(6)
  created_at                            DateTime?                      @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime?                      @default(now()) @db.Timestamptz(6)
  user_accounts                         user_accounts                  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  players                               players[]
  form_submissions                      form_submissions[]
  event_templates                       event_templates[]
  events_events_created_byToadmin_users events[]                       @relation("events_created_byToadmin_users")
  events_events_updated_byToadmin_users events[]                       @relation("events_updated_byToadmin_users")
  open_play_schedule_overrides          open_play_schedule_overrides[]

  @@schema("app_auth")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model api_keys {
  id            String         @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  account_id    String?        @db.Uuid
  name          String         @db.VarChar(255)
  key_hash      String
  permissions   Json?          @default("{}")
  is_active     Boolean?       @default(true)
  last_used_at  DateTime?      @db.Timestamptz(6)
  expires_at    DateTime?      @db.Timestamptz(6)
  created_at    DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?      @default(now()) @db.Timestamptz(6)
  user_accounts user_accounts? @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("app_auth")
}

