# Coolify / production — set these in Coolify Environment Variables (not committed)

# Public site
SITE_URL=https://thedinkhousepb.com
NEXT_PUBLIC_SITE_URL=https://thedinkhousepb.com

# Next → backend (Coolify compose overrides this to http://backend:3001)
BACKEND_URL=http://localhost:3001

# Postgres (Hetzner / your PG)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/postgres

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Brevo SMTP (xsmtpsib-… key — not xkeysib API key)
BREVO_API_KEY=
# Verified sender shown on emails
BREVO_FROM_EMAIL=contact@thedinkhousepb.com
# Exact Login from Brevo SMTP settings (e.g. 9a1c78001@smtp-brevo.com)
BREVO_SMTP_USER=9a1c78001@smtp-brevo.com

# Backend CORS (comma-separated)
CORS_ORIGIN=https://thedinkhousepb.com,https://www.thedinkhousepb.com

# Optional rate limits (Next contact form)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=50
